{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/src"],
  "testMatch": ["**/__tests__/**/*.test.ts"],
  "setupFiles": ["<rootDir>/src/__tests__/setup.ts"],
  "collectCoverageFrom": ["src/**/*.ts", "!src/index.ts", "!src/jobs/**", "!src/__tests__/**"],
  "coverageReporters": ["text", "lcov"],
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", { "tsconfig": { "paths": {} } }]
  }
}
